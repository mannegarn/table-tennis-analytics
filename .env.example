# Copy to .env and fill in real values: cp .env.example .env
POSTGRES_USER=tt
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tt_stats
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Integration tests run against a separate database so they can never touch
# collected data. It is created by db/init/000_create_test_db.sql on a fresh
# container; for an existing one run:
#   psql -U postgres -c "CREATE DATABASE tt_stats_test;"
# Override the name, or inject a full URL, only if you need to.
# TEST_DATABASE_NAME=tt_stats_test
# TEST_DATABASE_URL=postgresql://tt:change_me@localhost:5432/tt_stats_test

# Logging, read by configure_logging() at process entry points.
# LOG_LEVEL is the file handler level: the audit trail records everything.
# LOG_CONSOLE_LEVEL is the stderr level: WARNING keeps routine progress off the
# terminal so it cannot collide with the progress bar.
# LOG_JSON: true emits one JSON object per line, false emits readable output
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=WARNING
LOG_JSON=false

# Durable log file, written in addition to the console. Rotation is size based,
# so an unattended backfill cannot fill the disk.
LOG_TO_FILE=true
# LOGS_DIR=./logs
LOG_FILE_MAX_BYTES=5000000
LOG_FILE_BACKUP_COUNT=3

# WTT collection. Concurrency is the number of requests in flight; 20 measured
# comfortably against this API and is what the collectors report as "workers".
MAX_CONCURRENT_REQUESTS=20
# How many years (calendar) or events (match lists) are fetched per batch. A
# batch is a scheduling and commit-granularity unit, not a concurrency limit.
CHUNK_SIZE=50
# Per-attempt timeout, then exponential backoff with jitter between attempts.
REQUEST_TIMEOUT_SECONDS=40
MAX_RETRY_ATTEMPTS=6
RETRY_WAIT_MIN_SECONDS=2
RETRY_WAIT_MAX_SECONDS=16
REQUEST_JITTER_SECONDS=0.01
# First calendar year the events-by-year collector reads; the range always
# runs through the current year. 1926 is the earliest year the API returns any
# tournaments for, so this is the floor of a full backfill.
EVENTS_START_YEAR=1926

# Optional on-disk locations. Leave unset to use the repository layout, which
# is what a plain checkout and an editable install expect. Set them when the
# project is installed as a wheel or run inside a container.
# MIGRATIONS_DIR=./db/migrations
# DATA_DIR=./data
