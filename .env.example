# Copy to .env and fill in real values: cp .env.example .env
POSTGRES_USER=tt
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tt_stats
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Integration tests run against a separate database so they can never touch
# scraped data. It is created by db/init/000_create_test_db.sql on a fresh
# container; for an existing one run:
#   psql -U postgres -c "CREATE DATABASE tt_stats_test;"
# Override the name, or inject a full URL, only if you need to.
# TEST_DATABASE_NAME=tt_stats_test
# TEST_DATABASE_URL=postgresql://tt:change_me@localhost:5432/tt_stats_test

# Logging, read by configure_logging() at process entry points.
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_JSON: true emits one JSON object per line, false emits readable console output
LOG_LEVEL=INFO
LOG_JSON=false

# Durable log file, written in addition to the console. Rotation is size based,
# so an unattended backfill cannot fill the disk.
LOG_TO_FILE=true
# LOGS_DIR=./logs
LOG_FILE_MAX_BYTES=5000000
LOG_FILE_BACKUP_COUNT=3

# WTT scraping. Keep concurrency low; the site is not a bulk API.
MAX_CONCURRENT_REQUESTS=6

# Optional on-disk locations. Leave unset to use the repository layout, which
# is what a plain checkout and an editable install expect. Set them when the
# project is installed as a wheel or run inside a container.
# MIGRATIONS_DIR=./db/migrations
# DATA_DIR=./data
